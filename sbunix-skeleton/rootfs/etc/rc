#!/bin/sh

echo SBUnix booting...

# ENH: Ensure essential environment variables are set and exported.
# HOME and PATH must be available for cd builtin and command resolution.
# These may already come from init's envp, but export them explicitly
# so child processes always inherit them.
export HOME=/
export PATH=/bin
export SHELL=/bin/sbush

if test -f /test/bin/badfd; then
    /test/bin/badfd
fi

# Verify /bin/sh exists (POSIX compliance)  
if test -f /bin/sh; then
    echo "[BOOT] /bin/sh found"
else
    echo "[BOOT] WARNING: /bin/sh not found!"
fi

# Run test suite only if test runner is present
if test -f /bin/run-tests; then
    if test "$SBUNIX_BOOT_RC" = "1"; then
        set BOOTMODE 1
    else
        set BOOTMODE 0
    fi

    if test -f /mnt/.persist_sentinel; then
        # Boot 2: persistence verify phase only, then poweroff
        /test/bin/persisttest
        /bin/poweroff
    else
        if test "$BOOTMODE" = "1"; then
            echo ""
            echo "=========================================="
            echo "  Optional Automatic Testing"
            echo "=========================================="
            echo ""
            echo "Press Ctrl-C NOW to skip automatic tests"
            echo "and go directly to the interactive shell."
            echo ""
            echo -n "Starting tests in: 3"
            sleep 1 || exit 0
            echo -n "... 2" 
            sleep 1 || exit 0
            echo -n "... 1"
            sleep 1 || exit 0
            echo ""
            echo ""
        fi

        echo "Running SBUnix regression tests..."
        run-tests

        if test "$BOOTMODE" = "1"; then
            echo ""
            echo "=========================================="
            echo "  Boot Testing Complete"
            echo "=========================================="
            echo ""
            echo "Available commands:"
            echo "  run-tests          - Run SBUnix regression tests"  
            echo "  run-os-test        - Run Sortix POSIX compliance tests"
            echo "  run-open-posix-test - Run Open POSIX test suite"
            echo "  poweroff           - Shutdown system"
            echo ""
        fi
    fi
fi
